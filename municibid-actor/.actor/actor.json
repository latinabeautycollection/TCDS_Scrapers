{
  "actorSpecification": 1,
  "name": "municibid-actor",
  "title": "Municibid Acquisition Intelligence & eBay Comp Engine",
  "description": "Fortune-500 hardened, PropertyRoom/PublicSurplus-aligned Municibid acquisition actor with exhaustive discovery, verified single-writer fencing, zero-loss reconciliation, resilient recovery, source DLQ, mutable auction-state capture, and governed eBay comp enrichment.",
  "version": "1.3.13",
  "buildTag": "release-1.3.13",
  "environmentVariables": {
    "NODE_ENV": "production",
    "DEFAULT_SCHEMA_NAME": "arb.unified_listing.v1",
    "DEFAULT_SCHEMA_VERSION": "1",
    "DEFAULT_CURRENCY": "USD",
    "WEBHOOK_DELIVERY_REQUIRED": "false",
    "ZERO_RESULTS_ALERT_THRESHOLD": "1"
  },
  "dockerfile": "./Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Unified Acquisition Records",
      "description": "Governed normalized records originating from Municibid auction listings, eBay comparable listings, and downstream arbitrage evaluation outputs.",
      "views": {
        "overview": {
          "title": "Overview",
          "description": "Executive cross-source operator view of all normalized records.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "title",
              "category",
              "condition",
              "current_price",
              "buyers_premium",
              "estimated_shipping",
              "total_estimated_cost",
              "auction_end_time",
              "location",
              "risk_score",
              "purchase_recommendation",
              "scraped_at",
              "actor_run_id",
              "mpn",
              "model",
              "attributes/condition_source",
              "shipping_evidence",
              "condition_evidence"
            ]
          }
        },
        "municibid_listings": {
          "title": "Municibid Listings",
          "description": "Source auction records extracted from Municibid.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "listing_url",
              "title",
              "year",
              "make",
              "manufacturer",
              "model",
              "model_number",
              "vin",
              "mileage",
              "hours",
              "serial_number",
              "custom_id",
              "category",
              "subcategory",
              "condition",
              "current_price",
              "buyers_premium",
              "estimated_shipping",
              "tax_estimate",
              "total_estimated_cost",
              "auction_end_time",
              "location",
              "asset_id",
              "auction_id",
              "minimum_bid",
              "bid_increment",
              "bid_count",
              "buyers_premium_pct",
              "auction_status",
              "time_remaining_seconds",
              "auction_extension_possible",
              "bid_deposit",
              "seller_name",
              "pickup_required",
              "shipping_available",
              "currency",
              "scraped_at",
              "actor_run_id",
              "price_type",
              "shipping_method",
              "auction_start_time",
              "auction_start_time_source",
              "source_record",
              "attributes",
              "description",
              "images",
              "mpn",
              "attributes/condition_source",
              "shipping_evidence",
              "condition_evidence"
            ]
          }
        },
        "ebay_comps": {
          "title": "eBay Comparable Listings",
          "description": "Comparable market listings and sold comps retrieved from eBay.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "source",
              "external_id",
              "listing_url",
              "title",
              "category",
              "condition",
              "current_price",
              "estimated_shipping",
              "currency",
              "listing_type",
              "sold_status",
              "comp_query",
              "auction_end_time",
              "scraped_at",
              "actor_run_id"
            ]
          }
        },
        "arbitrage_candidates": {
          "title": "Arbitrage Candidates",
          "description": "Decision-ready opportunities enriched with cost, resale, margin, and recommendation outputs.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "title",
              "category",
              "condition",
              "current_price",
              "buyers_premium",
              "estimated_shipping",
              "tax_estimate",
              "total_estimated_cost",
              "median_comp_price",
              "avg_comp_price",
              "estimated_ebay_fees",
              "estimated_profit",
              "estimated_margin_pct",
              "risk_score",
              "confidence_score",
              "purchase_recommendation",
              "decision_reason",
              "scraped_at",
              "actor_run_id"
            ]
          }
        },
        "audit_trace": {
          "title": "Audit Trace",
          "description": "Operational traceability, lineage, integrity, and pipeline metadata.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "listing_url",
              "dedupe_key",
              "content_hash",
              "normalization_status",
              "input_fingerprint",
              "actor_run_id",
              "actor_build_id",
              "actor_task_id",
              "pipeline_stage",
              "scraped_at",
              "observed_at"
            ]
          }
        },
        "auction_logistics": {
          "title": "Auction Logistics",
          "description": "Municibid logistics, inspection, pickup, seller, and bidder-eligibility intelligence.",
          "transformation": {
            "fields": [
              "source",
              "external_id",
              "listing_url",
              "title",
              "category",
              "subcategory",
              "year",
              "make",
              "manufacturer",
              "model",
              "model_number",
              "vin",
              "mileage",
              "hours",
              "serial_number",
              "custom_id",
              "seller_name",
              "location",
              "shipping_available",
              "pickup_required",
              "pickup_location",
              "inspection_available",
              "inspection_details",
              "payment_terms",
              "removal_requirements",
              "bidding_allowed",
              "bidding_eligibility",
              "bidding_restriction_message",
              "auction_end_time",
              "scraped_at"
            ]
          }
        }
      }
    }
  }
}