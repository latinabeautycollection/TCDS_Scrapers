{
  "actorSpecification": 1,
  "name": "publicsurplus-actor",
  "title": "Public Surplus Acquisition Intelligence & eBay Comp Engine",
  "description": "Fortune-500 hardened, PropertyRoom-aligned acquisition actor that exhaustively discovers Public Surplus lots, captures mutable auction state, checkpoints/restarts safely, replays failed requests, prevents concurrent state corruption, reconciles zero-loss coverage, enriches with optional eBay comparables, and emits governed unified records.",
  "version": "1.3.14",
  "buildTag": "release-1.3.14",
  "environmentVariables": {
    "NODE_ENV": "production",
    "DEFAULT_SCHEMA_NAME": "arb.unified_listing.v1",
    "DEFAULT_SCHEMA_VERSION": "1",
    "DEFAULT_CURRENCY": "USD",
    "WEBHOOK_DELIVERY_REQUIRED": "false",
    "ZERO_RESULTS_ALERT_THRESHOLD": "1"
  },
  "dockerfile": "./Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Unified Acquisition Records",
      "description": "Governed normalized records originating from Public Surplus auction listings, eBay comparable listings, and downstream arbitrage evaluation outputs.",
      "views": {
        "overview": {
          "title": "Overview",
          "description": "Executive cross-source operator view of all normalized records.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "title",
              "category",
              "condition",
              "current_price",
              "price_type",
              "attributes",
              "source_record",
              "buyers_premium",
              "estimated_shipping",
              "shipping_method",
              "auction_start_time",
              "total_estimated_cost",
              "auction_end_time",
              "location",
              "risk_score",
              "purchase_recommendation",
              "scraped_at",
              "actor_run_id"
            ]
          }
        },
        "publicsurplus_listings": {
          "title": "Public Surplus Listings",
          "description": "Complete Public Surplus lot table with normalized auction, price, condition, image, seller, logistics, eligibility, lineage, and preserved source-page evidence.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "listing_url",
              "canonical_url",
              "title",
              "description",
              "category",
              "subcategory",
              "condition",
              "raw_condition",
              "brand",
              "model",
              "mpn",
              "current_price",
              "price_type",
              "starting_price",
              "minimum_bid",
              "buy_now_price",
              "bid_increment",
              "bid_count",
              "reserve_status",
              "reserve_met",
              "buyers_premium",
              "buyers_premium_pct",
              "buyers_premium_source",
              "buyers_premium_confidence",
              "estimated_shipping",
              "shipping_method",
              "shipping_evidence",
              "shipping_available",
              "pickup_required",
              "pickup_location",
              "shipping_weight",
              "shipping_weight_lbs",
              "tax_estimate",
              "total_estimated_cost",
              "currency",
              "auction_start_time",
              "auction_start_time_source",
              "auction_end_time",
              "auction_status",
              "time_remaining_seconds",
              "auction_extension_possible",
              "bid_deposit",
              "seller_name",
              "seller_agency",
              "seller_type",
              "location",
              "primary_image_url",
              "image_urls",
              "documents",
              "inspection_available",
              "inspection_details",
              "payment_terms",
              "removal_requirements",
              "bidding_allowed",
              "bidding_eligibility",
              "bidding_restriction_message",
              "requires_account_review",
              "attributes",
              "source_meta",
              "source_record",
              "asset_id",
              "auction_id",
              "lot_number",
              "risk_score",
              "purchase_recommendation",
              "decision_reason",
              "dedupe_key",
              "content_hash",
              "normalization_status",
              "pipeline_stage",
              "record_lineage",
              "scraped_at",
              "observed_at",
              "actor_run_id",
              "actor_build_id",
              "actor_task_id",
              "input_fingerprint"
            ]
          }
        },
        "ebay_comps": {
          "title": "eBay Comparable Listings",
          "description": "Comparable market listings and sold comps retrieved from eBay.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "source",
              "external_id",
              "listing_url",
              "title",
              "category",
              "condition",
              "current_price",
              "estimated_shipping",
              "currency",
              "listing_type",
              "sold_status",
              "comp_query",
              "auction_end_time",
              "scraped_at",
              "actor_run_id"
            ]
          }
        },
        "arbitrage_candidates": {
          "title": "Arbitrage Candidates",
          "description": "Decision-ready opportunities enriched with cost, resale, margin, and recommendation outputs.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "title",
              "category",
              "condition",
              "current_price",
              "buyers_premium",
              "estimated_shipping",
              "tax_estimate",
              "total_estimated_cost",
              "median_comp_price",
              "avg_comp_price",
              "estimated_ebay_fees",
              "estimated_profit",
              "estimated_margin_pct",
              "risk_score",
              "confidence_score",
              "purchase_recommendation",
              "decision_reason",
              "scraped_at",
              "actor_run_id"
            ]
          }
        },
        "audit_trace": {
          "title": "Audit Trace",
          "description": "Operational traceability, lineage, integrity, and pipeline metadata.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "listing_url",
              "dedupe_key",
              "content_hash",
              "normalization_status",
              "input_fingerprint",
              "actor_run_id",
              "actor_build_id",
              "actor_task_id",
              "pipeline_stage",
              "scraped_at",
              "observed_at",
              "source_record"
            ]
          }
        },
        "auction_logistics": {
          "title": "Auction Logistics",
          "description": "Public Surplus logistics, inspection, pickup, seller, and bidder-eligibility intelligence.",
          "transformation": {
            "fields": [
              "source",
              "external_id",
              "listing_url",
              "title",
              "seller_name",
              "location",
              "shipping_available",
              "pickup_required",
              "pickup_location",
              "inspection_available",
              "inspection_details",
              "payment_terms",
              "removal_requirements",
              "bidding_allowed",
              "bidding_eligibility",
              "bidding_restriction_message",
              "auction_end_time",
              "auction_start_time",
              "shipping_method",
              "scraped_at"
            ]
          }
        }
      }
    }
  }
}