{
  "actorSpecification": 1,
  "name": "liquidation-actor",
  "title": "Liquidation Acquisition Intelligence & eBay Comp Engine",
  "description": "Fortune-500 hardened, PropertyRoom-aligned Liquidation.com acquisition actor with exhaustive lot discovery, manifest provenance, zero-loss reconciliation, resilient recovery, source DLQ, mutable auction-state capture, and governed eBay comp enrichment.",
  "version": "1.1.10",
  "buildTag": "release-1.1.10",
  "environmentVariables": {
    "NODE_ENV": "production",
    "DEFAULT_SCHEMA_NAME": "arb.unified_listing.v1",
    "DEFAULT_SCHEMA_VERSION": "1",
    "DEFAULT_CURRENCY": "USD",
    "WEBHOOK_DELIVERY_REQUIRED": "false",
    "ZERO_RESULTS_ALERT_THRESHOLD": "1",
    "RELEASE_ARTIFACT_SHA256": "",
    "CERTIFICATION_MODE": "candidate"
  },
  "dockerfile": "./Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Unified Acquisition Records",
      "description": "Governed normalized records originating from Liquidation auction listings, eBay comparable listings, and downstream arbitrage evaluation outputs.",
      "views": {
        "overview": {
          "title": "Overview",
          "description": "Executive cross-source operator view of all normalized records.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "title",
              "category",
              "condition",
              "current_price",
              "price_type",
              "buy_now_price",
              "buyers_premium",
              "estimated_shipping",
              "shipping_method",
              "total_estimated_cost",
              "auction_start_time",
              "auction_end_time",
              "source_record",
              "location",
              "risk_score",
              "purchase_recommendation",
              "scraped_at",
              "actor_run_id",
              "model",
              "mpn",
              "shipping_evidence"
            ]
          }
        },
        "liquidation_listings": {
          "title": "Liquidation Listings",
          "description": "Source auction records extracted from Liquidation.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "auction_id",
              "listing_url",
              "title",
              "category",
              "subcategory",
              "condition",
              "raw_condition",
              "current_price",
              "price_type",
              "price_status",
              "minimum_bid",
              "buy_now_price",
              "bid_count",
              "buyers_premium_pct",
              "buyers_premium",
              "currency",
              "auction_end_time",
              "auction_start_time",
              "auction_status",
              "time_remaining_seconds",
              "seller_name",
              "seller_type",
              "location",
              "country",
              "quantity",
              "unit_count",
              "shipping_available",
              "estimated_shipping",
              "shipping_method",
              "pickup_required",
              "payment_terms",
              "removal_requirements",
              "documents",
              "source_meta",
              "source_record",
              "scraped_at",
              "actor_run_id",
              "auction_start_time_source",
              "model",
              "mpn",
              "shipping_evidence"
            ]
          }
        },
        "ebay_comps": {
          "title": "eBay Comparable Listings",
          "description": "Comparable market listings and sold comps retrieved from eBay.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "source",
              "external_id",
              "listing_url",
              "title",
              "category",
              "condition",
              "current_price",
              "estimated_shipping",
              "currency",
              "listing_type",
              "sold_status",
              "comp_query",
              "auction_end_time",
              "scraped_at",
              "actor_run_id"
            ]
          }
        },
        "arbitrage_candidates": {
          "title": "Arbitrage Candidates",
          "description": "Decision-ready opportunities enriched with cost, resale, margin, and recommendation outputs.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "title",
              "category",
              "condition",
              "current_price",
              "buyers_premium",
              "estimated_shipping",
              "tax_estimate",
              "total_estimated_cost",
              "median_comp_price",
              "avg_comp_price",
              "estimated_ebay_fees",
              "estimated_profit",
              "estimated_margin_pct",
              "risk_score",
              "confidence_score",
              "purchase_recommendation",
              "decision_reason",
              "scraped_at",
              "actor_run_id"
            ]
          }
        },
        "audit_trace": {
          "title": "Audit Trace",
          "description": "Operational traceability, lineage, integrity, and pipeline metadata.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "listing_type",
              "source",
              "external_id",
              "listing_url",
              "dedupe_key",
              "content_hash",
              "normalization_status",
              "input_fingerprint",
              "actor_run_id",
              "actor_build_id",
              "actor_task_id",
              "pipeline_stage",
              "scraped_at",
              "observed_at"
            ]
          }
        },
        "auction_logistics": {
          "title": "Auction Logistics",
          "description": "Liquidation logistics, inspection, pickup, seller, and bidder-eligibility intelligence.",
          "transformation": {
            "fields": [
              "source",
              "external_id",
              "listing_url",
              "title",
              "category",
              "subcategory",
              "year",
              "make",
              "manufacturer",
              "model",
              "model_number",
              "vin",
              "mileage",
              "hours",
              "serial_number",
              "custom_id",
              "seller_name",
              "location",
              "shipping_available",
              "estimated_shipping",
              "shipping_method",
              "pickup_required",
              "pickup_location",
              "inspection_available",
              "inspection_details",
              "payment_terms",
              "removal_requirements",
              "bidding_allowed",
              "bidding_eligibility",
              "bidding_restriction_message",
              "auction_end_time",
              "auction_start_time",
              "scraped_at",
              "source_record"
            ]
          }
        },
        "liquidation_manifest_items": {
          "title": "Liquidation Manifest Items",
          "description": "Manifest line-item intelligence emitted from Liquidation.com manifested lots.",
          "transformation": {
            "fields": [
              "schema",
              "schema_version",
              "record_type",
              "source",
              "external_id",
              "listing_url",
              "title",
              "category",
              "condition",
              "current_price",
              "currency",
              "auction_id",
              "parent_external_id",
              "manifest_line_no",
              "sku",
              "upc",
              "quantity",
              "retail_price",
              "retail_currency",
              "manifest_notes",
              "scraped_at",
              "actor_run_id",
              "model",
              "mpn",
              "shipping_evidence"
            ]
          }
        }
      }
    }
  }
}